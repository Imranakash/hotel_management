<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_building_form" model="ir.ui.view">
        <field name="name">hotel.building.form</field>
        <field name="model">hotel.building</field>
        <field name="arch" type="xml">
            <form string="Building">
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. Tower A, North Wing"/>
                        <field name="property_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hotel_room_type_form" model="ir.ui.view">
        <field name="name">hotel.room.type.form</field>
        <field name="model">hotel.room.type</field>
        <field name="arch" type="xml">
            <form string="Room Category">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Room Type Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Deluxe Couple Room, Suite"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="code" placeholder="e.g. DLX, SUT, STD"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Capacity &amp; Policies" name="capacity_policies">
                            <group>
                                <group string="Capacity Setup">
                                    <field name="base_adults"/>
                                    <field name="base_children"/>
                                    <field name="max_capacity"/>
                                </group>
                                <group string="Extra Bed Policy">
                                    <field name="allow_extra_bed" widget="boolean_toggle"/>
                                    <field name="max_extra_beds" invisible="not allow_extra_bed"/>
                                </group>
                            </group>
                        </page>

                        <page string="Specifications &amp; Amenities" name="specifications_amenities">
                            <group>
                                <group string="ROOM SPECIFICATIONS">
                                    <field name="bed_type"/>
                                    <field name="view_type"/>
                                    <field name="room_area"/>
                                </group>

                                <group string="ROOM AMENITIES">
                                    <field name="amenity_ids"
                                           widget="many2many_tags"
                                           options="{'color_field': 'color', 'no_create': True, 'no_create_edit': True}"
                                           placeholder="Select amenities (e.g. Slippers, Room Service, Toiletries)..."/>
                                </group>
                            </group>

                            <group string="Description / Features">
                                <field name="description" nolabel="1" placeholder="Write room description here..."/>
                            </group>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>


    <record id="view_hotel_room_type_kanban" model="ir.ui.view">
        <field name="name">hotel.room.type.kanban</field>
        <field name="model">hotel.room.type</field>
        <field name="arch" type="xml">
            <kanban sample="1" records_draggable="false">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="max_capacity"/>
                <field name="bed_type"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-3 d-flex flex-column justify-content-between row-gap-2">
                            <div>
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <strong class="fs-4 text-dark">✨ <field name="name"/></strong>
                                    <span class="badge bg-primary text-uppercase"><field name="code"/></span>
                                </div>

                                <div class="text-muted small mb-1">
                                    🛏️ Bed Type: <span class="fw-bold text-dark"><field name="bed_type"/></span>
                                </div>
                            </div>

                            <div class="border-top pt-2 mt-1 d-flex justify-content-between align-items-center small text-muted">
                                <span>👥 Max Capacity:</span>
                                <span class="fw-bold text-danger fs-5"><field name="max_capacity"/> Persons</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hotel_building_list" model="ir.ui.view">
        <field name="name">hotel.building.list</field>
        <field name="model">hotel.building</field>
        <field name="arch" type="xml">
            <list string="Buildings">
                <field name="name"/>
                <field name="property_id"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_floor_form" model="ir.ui.view">
        <field name="name">hotel.floor.form</field>
        <field name="model">hotel.floor</field>
        <field name="arch" type="xml">
            <form string="Floor">
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. 1st Floor, Ground Floor"/>
                        <field name="building_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hotel_floor_list" model="ir.ui.view">
        <field name="name">hotel.floor.list</field>
        <field name="model">hotel.floor</field>
        <field name="arch" type="xml">
            <list string="Floors">
                <field name="name"/>
                <field name="building_id"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_room_amenity_form" model="ir.ui.view">
        <field name="name">hotel.room.amenity.form</field>
        <field name="model">hotel.room.amenity</field>
        <field name="arch" type="xml">
            <form string="Room Amenity">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. Free Wi-Fi, Air Conditioning"/>
                            <field name="code" placeholder="e.g. WIFI, AC"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <group string="Additional Info">
                        <field name="description" placeholder="Add amenity details here..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Amenities List View -->
    <record id="view_hotel_room_amenity_list" model="ir.ui.view">
        <field name="name">hotel.room.amenity.list</field>
        <field name="model">hotel.room.amenity</field>
        <field name="arch" type="xml">
            <list string="Room Amenities">
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- Amenities Action -->
    <record id="action_hotel_room_amenity" model="ir.actions.act_window">
        <field name="name">Room Amenities</field>
        <field name="res_model">hotel.room.amenity</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Room Amenity master data!
            </p>
        </field>
    </record>
</odoo>