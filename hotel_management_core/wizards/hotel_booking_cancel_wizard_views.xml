<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_booking_cancel_wizard_form" model="ir.ui.view">
        <field name="name">hotel.booking.cancel.wizard.form</field>
        <field name="model">hotel.booking.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Booking Confirmation">
                <sheet>
                    <div class="text-center mb-3">
                        <h4 class="text-danger fw-bold">Are you sure you want to cancel this booking?</h4>
                        <p class="text-muted">Calculated breakdown based on arrival date:</p>
                    </div>
                    <group>
                        <group>
                            <field name="advance_amount"/>
                            <field name="refund_percentage"/>
                        </group>
                        <group>
                            <field name="refund_amount" class="text-success fw-bold"/>
                            <field name="cancellation_fee" class="text-danger fw-bold"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm Cancel" name="action_confirm_cancel" type="object" class="btn-danger rounded-pill"/>
                    <button string="Discard" class="btn-secondary rounded-pill" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>