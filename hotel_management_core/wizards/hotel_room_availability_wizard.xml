<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_hotel_room_availability_wizard_form" model="ir.ui.view">
            <field name="name">hotel.room.availability.wizard.form</field>
            <field name="model">hotel.room.availability.wizard</field>
            <field name="arch" type="xml">
                <form string="Room Availability">
                    <sheet>
                        <div class="text-center mb-4">
                            <h2 class="fw-bold text-primary mb-0">
                                <i class="fa fa-bed me-2"/>Room Availability Search
                            </h2>
                            <div class="text-muted">Check confirmed bookings and free rooms for a category</div>
                        </div>

                        <div class="p-4 mb-4 rounded-3 bg-white"
                             style="border: 1px solid #e0e0e0; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
                            <group>
                                <group>
                                    <field name="property_id"
                                           options="{'no_create': True, 'no_open': True}"/>
                                    <field name="room_type_id"
                                           options="{'no_create': True, 'no_open': True}"/>
                                </group>
                                <group>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                </group>
                            </group>

                            <div class="text-center mt-3">
                                <button name="action_search" type="object" string="Search Availability"
                                        class="btn btn-primary fw-bold px-4 py-2 rounded-pill shadow-sm"
                                        icon="fa-search"/>
                            </div>
                        </div>

                        <field name="result_html" nolabel="1" readonly="1"
                               invisible="not result_html"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hotel_room_availability_wizard" model="ir.actions.act_window">
            <field name="name">Room Availability</field>
            <field name="res_model">hotel.room.availability.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_hotel_room_availability_wizard_form"/>
            <field name="target">current</field>
        </record>

    </data>
</odoo>